# Quit 9to5 content workflow: environment placeholders.
# Copy to .env (never commit .env) and fill in the values Pallav shares with you.
# Every value here is a placeholder. Real IDs and keys live only in your local .env or your MCP connector settings.

# ---------------------------------------------------------------- paths
# Root of the working content folder on your machine (the box uses its own quit9to5/ folder).
Q9_ROOT=/path/to/quit9to5
# Motion work and reel folders (each reel: NNN_slug/ for scripts, NNN_slug_L2/ for the build).
Q9_MOTION_DIR=${Q9_ROOT}/motion
Q9_REELS_DIR=${Q9_MOTION_DIR}/reels
# Folder that holds agent skills (only needed by scripts/sync_from_box.sh on the box).
Q9_SKILLS_DIR=/path/to/agent-skills
# Where this repo lives. sync_from_box.sh detects it from its own location if unset.
DEST=
# Optional: approved reel script folders that sync_from_box.sh mirrors into examples/.
APPROVED_REELS="004_runway 005_toxic_hike"

# ---------------------------------------------------------------- runtimes and builders
# Directory holding Node 22 (prepended to PATH so `npx hyperframes` resolves). Leave empty if node is on PATH.
NODE_BIN=
HYPERFRAMES_VERSION=0.9.72
# P1 builder: Antigravity CLI. Leave AGY_BIN empty if `agy` is on PATH.
AGY_BIN=
AGY_MODEL=gemini-4-neon-high
# Optional extra read-only dirs for agy (the box adds the blog folder so facts.md is readable).
AGY_EXTRA_DIRS=
# Local speech-to-text model for word timings (faster-whisper).
WHISPER_MODEL=small.en

# ---------------------------------------------------------------- ElevenLabs (the ONLY paid service allowed without asking)
ELEVENLABS_API_KEY=
# Pallav's cloned voice. Account-specific: ask Pallav. Never commit the real ID.
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_v4
ELEVENLABS_LANGUAGE=hi
ELEVENLABS_SIMILARITY=0.9
ELEVENLABS_STABILITY=0.5
# Shared CTA take used by scripts/splice_cta.py (default ${Q9_REELS_DIR}/shared_cta/cta.wav).
CTA_WAV=
CTA_TEXT="My book Quit 9to5 is coming out soon. Join the waitlist in bio."
# CSV where every paid call is logged. Header:
# timestamp_ist,bot,provider,model_or_service,purpose,units,unit_type,cost_usd,cost_basis,notes
PAID_CALL_LEDGER=/path/to/api-costs/ledger.csv
# Name to write in the ledger's "bot" column.
LEDGER_BOT_NAME=Quit9to5LaunchPlan

# ---------------------------------------------------------------- Buffer (free plan: 10 scheduled posts PER CHANNEL)
# Use the Buffer MCP connector, or an API token if you call the API directly.
BUFFER_ACCESS_TOKEN=
# Organisation "Quit 9to5". Get it from get_account; never guess.
BUFFER_ORG_ID=<BUFFER_ORG_ID>
# Channel IDs from list_channels (24-hex strings). X is NOT a Buffer channel any more.
BUFFER_CHANNEL_INSTAGRAM=<BUFFER_CHANNEL_ID_INSTAGRAM>   # @quit9to5book, automatic Reels
BUFFER_CHANNEL_LINKEDIN=<BUFFER_CHANNEL_ID_LINKEDIN>     # LinkedIn Page "Quit 9to5"
BUFFER_CHANNEL_THREADS=<BUFFER_CHANNEL_ID_THREADS>       # @quit9to5withpallav
POST_TIMEZONE=Asia/Calcutta
SLOT_TIMES="14:00 19:00"

# ---------------------------------------------------------------- Google Drive (public video URLs for Buffer)
# Folder "Motion reels". Must be "Anyone with the link: Viewer" (set in the Drive web UI; the connector cannot do it).
GDRIVE_MOTION_REELS_FOLDER_ID=<DRIVE_FOLDER_ID>
# Buffer video URL pattern (fill <DRIVE_FILE_ID> per upload):
# https://drive.usercontent.google.com/download?id=<DRIVE_FILE_ID>&export=download&confirm=t
# Google Doc folder used to paste blog HTML into beehiiv (optional).
GDRIVE_BLOG_DOCS_FOLDER_ID=<DRIVE_FOLDER_ID>
# Google Sheet mirror of the card/reel post log (optional).
POST_LOG_SHEET_ID=<GOOGLE_SHEET_ID>
# Local CSV post log (no-repeat gate and link-in-5 counter).
POST_LOG_CSV=${Q9_ROOT}/cards/post_log.csv

# ---------------------------------------------------------------- images
# Public image host used for Buffer card image URLs (the box uses iili.io).
IMAGE_HOST_API_KEY=
# Card template assets (not in the repo): pallav_photo.jpg, book_cover.jpeg.
Q9_CARD_ASSETS=/path/to/card-assets
# Fonts.
Q9_FONT_INTER=/path/to/Inter-VariableFont_opsz,wght.ttf
Q9_FONT_JOSEFIN=/path/to/JosefinSans-VariableFont_wght.ttf
Q9_FONT_DEJAVU_BOLD=/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf
# Blog thumbnail / X cover grid background (t4_seven.jpg, not in the repo).
BLOG_THUMB_BG=/path/to/blog/thumbs/t4_seven.jpg
BLOG_QA_DIR=${Q9_ROOT}/blog/qa
X_COVER_OUT_DIR=${Q9_ROOT}/crosspost

# ---------------------------------------------------------------- blog / Substack / X
BLOG_URL=https://blog.quit9to5.in/
# beehiiv publication (only if you use the beehiiv connector for read-back checks; publishing is done in the browser).
BEEHIIV_API_KEY=
BEEHIIV_PUBLICATION_ID=<BEEHIIV_PUBLICATION_ID>
SUBSTACK_URL=https://pallavkulhari.substack.com/
# X login is Google SSO; Pallav signs in himself. No X credentials belong here.

# ---------------------------------------------------------------- waitlist and analytics
WAITLIST_URL=https://www.quit9to5.in/
GA4_MEASUREMENT_ID=<GA4_MEASUREMENT_ID>

# ---------------------------------------------------------------- review bot (RRRI, "The Viewer")
# Post-publish review bot. Send it the live link(s) after anything public goes live.
REVIEW_BOT_ID=<REVIEW_BOT_UUID>
# How to reach it from your setup (chat handle, webhook, or "ask Pallav to forward").
REVIEW_BOT_CONTACT=<REVIEW_BOT_CONTACT>

# ---------------------------------------------------------------- notifications to Pallav
# Where review previews and questions go (chat channel / handle). No phone numbers in this file.
PALLAV_REVIEW_CHANNEL=<PALLAV_CHAT_CHANNEL>
